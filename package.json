{
  "name": "ui-studio",
  "version": "0.2.0",
  "description": "jjamong 공용 UI 컴포넌트 킷. 컴포넌트는 디자인 토큰(CSS 변수) 이름만 참조하고 값은 갖지 않는다 — 각 소비 프로젝트가 자기 테마 값으로 --ds-*, --text-* 변수를 정의해서 사용한다.",
  "private": false,
  "type": "module",
  "license": "UNLICENSED",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "prepare": "npm run build",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "peerDependencies": {
    "lucide-react": ">=0.300.0",
    "react": ">=18",
    "react-dom": ">=18"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@floating-ui/react": "^0.27.20",
    "clsx": "^2.1.1"
  },
  "devDependencies": {
    "@storybook/react-vite": "^10.5.10",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.1",
    "lucide-react": "^0.475.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "storybook": "^10.5.10",
    "tailwindcss": "^4.3.3",
    "tsup": "^8.3.5",
    "typescript": "~5.9.3",
    "vite": "^8.2.2"
  }
}
